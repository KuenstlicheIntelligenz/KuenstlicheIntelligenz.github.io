---
interface Props {
  title: string;
  url: string;
  date: Date;
  type: string;
  thumbnail?: string;
  summary?: string;
  location?: string;
  duration?: string;
  tags?: string[];
  youtubeId?: string;
}

const { title, url, date, type, thumbnail, summary, location, duration, tags, youtubeId } = Astro.props;

let thumbUrl = thumbnail;
if (!thumbUrl && youtubeId) {
  thumbUrl = `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg`;
}
if (!thumbUrl) {
  thumbUrl = `https://via.placeholder.com/400x400/3CA2A2/FFFFFF?text=${type}`;
}
---

<div class="feed-card" data-type={type}>
  <div class="feed-card-content">
    <h3 class="feed-card-title">
      <a href={url}>{title}</a>
    </h3>
    <div class="feed-card-meta">
      <i class="fas fa-calendar"></i> {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      {location && <span> | <i class="fas fa-map-marker-alt"></i> {location}</span>}
      {duration && <span> | <i class="fas fa-clock"></i> {duration}</span>}
    </div>
  </div>
  <div class="feed-card-image-container">
    <a href={url}>
      <img src={thumbUrl} alt={title} class="feed-card-image" loading="lazy">
    </a>
  </div>
  <div class="feed-card-content">
    {summary && <p class="feed-card-excerpt">{summary}</p>}
    {tags && tags.length > 0 && (
      <div class="feed-card-tags">
        {tags.slice(0, 3).map(tag => (
          <span class="feed-card-tag">#{tag}</span>
        ))}
      </div>
    )}
  </div>
</div>
