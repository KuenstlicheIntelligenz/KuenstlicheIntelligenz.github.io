---
import BaseLayout from './BaseLayout.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import SeriesNav from '../components/SeriesNav.astro';

interface Props {
  title: string;
  date: Date;
  youtube_id: string;
  series?: string;
  duration?: string;
  tags?: string[];
}

const { title, date, youtube_id, series, duration, tags } = Astro.props;
---

<BaseLayout title={title} ogType="article">
  <div class="container-fluid single">
    <div class="article video-article" itemscope itemtype="http://schema.org/VideoObject">

      <h1 class="header" itemprop="name">{title}</h1>

      <div class="author">
        <small><i>
          <span itemprop="datePublished">{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          {duration && (
            <span>
              <i class="fas fa-clock" style="margin-left: 1rem; color: var(--text-accent, #3CA2A2);"></i> {duration}
            </span>
          )}
          {series && (
            <span>
              <i class="fas fa-list" style="margin-left: 1rem; color: var(--text-accent, #3CA2A2);"></i> {series}
            </span>
          )}
        </i></small>
      </div>

      <div class="content-panel content">
        {series && <SeriesNav series={series} currentTitle={title} collection="videos" />}

        <YouTubeEmbed youtubeId={youtube_id} />

        <div class="post-content">
          <span itemprop="description">
            <slot />
          </span>
        </div>

        {tags && tags.length > 0 && (
          <div class="tags">
            <small>
              <i class="fas fa-tags"></i> {tags.join(', ')}
            </small>
          </div>
        )}
      </div>

    </div>
  </div>
</BaseLayout>
