---
import BaseLayout from './BaseLayout.astro';
import SeriesNav from '../components/SeriesNav.astro';
import readingTime from 'reading-time';

interface Props {
  title: string;
  date: Date;
  author?: string;
  summary?: string;
  categories?: string;
  thumbnail?: string;
  tags?: string[];
  series?: string;
  minutes?: number;
  body: string;
}

const { title, date, author, summary, categories, thumbnail, tags, series, minutes, body } = Astro.props;

const thumbnailMap: Record<string, string> = {
  gravatar: 'https://www.gravatar.com/avatar/00000000000000000000000000000000?s=500&d=mm',
  jekyll: 'https://i.imgur.com/aRQcGSi.png',
};

const readTime = minutes || Math.max(1, Math.ceil(readingTime(body).minutes));
const hasMath = body.includes('$$') || body.includes('\\[') || body.includes('math/tex');
---

<BaseLayout title={title} description={summary} author={author} ogType="article">
  <div class="container-fluid single">
    <div class="article" itemscope itemtype="http://schema.org/Article">

      {thumbnail && (
        <div class="thumb">
          {thumbnailMap[thumbnail] ? (
            <img itemprop="image" src={thumbnailMap[thumbnail]} alt={`Thumbnail: ${thumbnail}`} />
          ) : thumbnail.startsWith('http') || thumbnail.startsWith('/') ? (
            <img itemprop="image" src={thumbnail} alt={title} />
          ) : (
            <i class={`fas fa-${thumbnail} fa-4x`}></i>
          )}
        </div>
      )}

      <h1 class="header" itemprop="name">{title}</h1>

      <div class="author">
        <small><i>
          {author && (
            <span>by <span itemprop="author">{author}</span> </span>
          )}
          on <span itemprop="datePublished">{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          {categories && <span> under {categories.split(',')[0].trim()}</span>}
        </i></small>
      </div>

      <div class="read-time">
        <small>{readTime} minute read</small>
      </div>

      <div class="content-panel content">
        {series && <SeriesNav series={series} currentTitle={title} collection="posts" />}

        <span itemprop="articleBody">
          <slot />
        </span>

        {tags && tags.length > 0 && (
          <div class="tags">
            <small>
              <i class="fas fa-tags"></i> {tags.join(', ')}
            </small>
          </div>
        )}
      </div>

    </div>
  </div>

  {hasMath && (
    <script is:inline>
      window.MathJax = {
        tex: { inlineMath: [['$', '$'], ['\\(', '\\)']] },
      };
    </script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" async></script>
  )}
</BaseLayout>
