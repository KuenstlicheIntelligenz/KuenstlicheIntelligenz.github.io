---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Technical Content">
  <div class="container-fluid index">
    <h1 class="header author-header"><i class="fas fa-code"></i> Technical Content</h1>
    <p style="color: #999; text-align: center; margin-bottom: 2rem;">
      Deep dives into AI, machine learning, cloud infrastructure, and software engineering.
    </p>

    <div class="posts-list" style="max-width: 800px; margin: 0 auto;">
      {sorted.map(post => (
        <div class="post-preview" style="padding: 1rem 0; border-bottom: 1px solid rgba(60,162,162,0.1);">
          <h3 style="margin: 0 0 0.3rem;">
            <a href={`/posts/${post.id}/`} style="color: #D0D0D0; text-decoration: none;">{post.data.title}</a>
          </h3>
          <small style="color: #999;">
            <i class="fas fa-calendar"></i> {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            {post.data.categories && <span> | {post.data.categories}</span>}
          </small>
          {post.data.summary && <p style="color: #999; margin: 0.5rem 0 0; font-size: 0.9rem;">{post.data.summary}</p>}
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
