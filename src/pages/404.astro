---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<BaseLayout title="404">
  <div class="container-fluid index error">
    <div class="content-panel articles" style="text-align: center;">
      <h1 class="header author-header">404</h1>
      <div class="error-text" style="color: #999; margin: 1rem 0;">
        Sorry but this page doesn't seem to exist.
      </div>
      <div style="margin: 1rem 0;">
        <a href="/">Home</a> |
        <a href="/posts/">All Posts</a> |
        <a href="/search/">Search</a>
      </div>
      <SocialLinks />
    </div>
  </div>
</BaseLayout>
