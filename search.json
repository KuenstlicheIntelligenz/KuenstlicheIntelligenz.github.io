---
layout: none
---
[
  {% for post in site.posts %}
  {
    "title"    : "{{ post.title | escape }}",
    "category" : "{{ post.category }}",
    "tags"     : "{{ post.tags | join: ', ' }}",
    "url"      : "{{ site.baseurl }}{{ post.url }}",
    "date"     : "{{ post.date }}",
    "type"     : "post"
    } ,
    {% endfor %}
  {% for item in site.travel %}
  {
    "title"    : "{{ item.title | escape }}",
    "category" : "Travel",
    "tags"     : "{{ item.tags | join: ', ' }}",
    "url"      : "{{ site.baseurl }}{{ item.url }}",
    "date"     : "{{ item.date }}",
    "type"     : "travel"
    } ,
    {% endfor %}
  {% for item in site.kitesurf %}
  {
    "title"    : "{{ item.title | escape }}",
    "category" : "Kitesurf",
    "tags"     : "{{ item.tags | join: ', ' }}",
    "url"      : "{{ site.baseurl }}{{ item.url }}",
    "date"     : "{{ item.date }}",
    "type"     : "kitesurf"
    } ,
    {% endfor %}
  {% for item in site.videos %}
  {
    "title"    : "{{ item.title | escape }}",
    "category" : "Video",
    "tags"     : "{{ item.tags | join: ', ' }}",
    "url"      : "{{ site.baseurl }}{{ item.url }}",
    "date"     : "{{ item.date }}",
    "type"     : "video"
    } {% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
